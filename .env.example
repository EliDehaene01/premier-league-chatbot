# Copy to .env and fill in. .env is gitignored; never commit real values.
POSTGRES_USER=plc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plc
POSTGRES_HOST=localhost
# 5433 on the host: a native Windows Postgres service may already hold 5432
POSTGRES_PORT=5433

# Azure OpenAI via Microsoft Foundry (Phase 2)
# Endpoint form: https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Content Safety (Prompt Shields)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=

# Current season (start year): 2026 = 2026-27
PL_SEASON=2026

# Set to 1 to run tests marked `live` against the real APIs
PLC_LIVE_TESTS=0

# Tracing: self-hosted Langfuse (docker-compose.langfuse.yml). Leave empty to trace nothing.
# `python scripts/langfuse_env.py` fills these (and the Langfuse service secrets) in .env.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Tools: "mcp" (default; the MCP server, in-process unless MCP_URL is set) or "direct"
TOOL_TRANSPORT=mcp
MCP_URL=
